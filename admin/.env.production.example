# Salin ke .env di server (jangan unggah .env lokal). Isi nilai yang bertanda GANTI.
APP_NAME="MOTEQAR Admin"
APP_ENV=production
APP_KEY=                       # isi lewat: php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://GANTI.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Pilih satu. MySQL (disarankan di hosting) atau SQLite (cukup untuk trafik kecil, file database/database.sqlite).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=GANTI
DB_USERNAME=GANTI
DB_PASSWORD=GANTI

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Landing page satu domain dengan admin, jadi CORS tidak dipakai. Biarkan kosong.
LANDING_ORIGINS=

# Email (lihat README bagian Notifikasi email)
MAIL_MAILER=smtp
MAIL_HOST=GANTI
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=GANTI
MAIL_PASSWORD=GANTI
MAIL_FROM_ADDRESS="no-reply@GANTI.com"
MAIL_FROM_NAME="MOTEQAR"

# Login dengan Google (opsional; tombol hanya muncul kalau keduanya diisi). Lihat ../DEPLOY.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
